# Helm 2.0 server configuration. Copy to .env and fill in. Never commit .env.

# Static API key for curl and scripts (X-Helm-Key header). Leave empty and the API fails closed.
HELM_API_KEY=

# VAPID keys for web push: npx web-push generate-vapid-keys
HELM_VAPID_PUBLIC=
HELM_VAPID_PRIVATE=
HELM_VAPID_SUBJECT=mailto:you@example.com

# Address the server listens on. Use 127.0.0.1: tailscale serve terminates HTTPS and proxies to it,
# so nothing else can reach the server directly.
HELM_BIND_ADDR=127.0.0.1
HELM_PORT=8420

# Tailnet hostname (tailscale status --self --json | jq -r .Self.DNSName, minus the trailing dot).
# This is the WebAuthn relying party id; the phone must open exactly https://<this>.
HELM_HOSTNAME=

# Session cookie lifetime in hours. One value; stretch it if 12 annoys you.
HELM_SESSION_HOURS=12

# Paths. Defaults shown.
HELM_HOME=~/.helm2
HELM_VAULT_ROOT=~/Projects/otto/Vault
HELM_ADD_DIRS=~/Projects:~/Desktop:~/Documents
HELM_STATIC_DIR=./public
