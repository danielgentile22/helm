# Paths the guard lets into this public repo. One Python regex per line, matched
# against the repo-relative path. A line starting with ! denies, and denies win.

^(bench|dashboard|runner|demo-vault|docs|\.githooks|\.github)/
^skills/update-vault/
^(models\.json|README\.md|CLAUDE\.md|AGENTS\.md|GLOSSARY\.md|LICENSE|\.gitignore|\.gitattributes|\.env\.example)$

# Personal or runtime material that must never land, even inside an allowed folder.
!(^|/)\.env($|\.(?!example$))
!(^|/)runs?/.*\.(json|jsonl|md)$
!(^|/)memory\.jsonl$
!(^|/)turns/
!(^|/)auth/.*\.json$
!(^|/)prototypes/
!^docs/audits/
!\.(bundle|tex|pdf|sqlite|db)$
