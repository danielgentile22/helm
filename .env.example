# helm's environment. Copy to `.env` and fill in only what you need to override.
# `.env` is gitignored; secrets live here and are referenced by name everywhere
# else. Every value below is optional and falls back to the default shown.

# Timezone for every local time helm prints or schedules against.
HELM_TZ=America/New_York

# The tailnet name the dashboard is served under, once `tailscale serve` fronts it
# (docs/adr/0018). Unset means loopback only, exactly as before. The port is the one
# `tailscale serve --https=<port>` listens on; the relying party id for passkeys is the
# bare hostname, so the port can change without re-enrolling.
HELM_HOSTNAME=
HELM_TAILNET_PORT=8643
