{
  "name": "helm2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drive Claude Code on the always-on Mac from a phone. Tailnet-only, passkey-gated.",
  "scripts": {
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "dev": "npm run build:client && node --import tsx src/server/main.ts",
    "build:client": "node scripts/build-client.mjs",
    "start": "node --import tsx src/server/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.268",
    "@hono/node-server": "^2.1.1",
    "@simplewebauthn/server": "^14.0.1",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.7",
    "marked": "^18.0.12",
    "web-push": "^3.6.7",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "0.9.5",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0"
  }
}
